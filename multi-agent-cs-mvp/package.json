{
  "name": "multi-agent-cs-mvp",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "build:shared": "npm --workspace packages/shared run build",
    "build:server": "npm --workspace apps/server run build",
    "build:web": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/server run start",
    "zip": "powershell -ExecutionPolicy Bypass -File ./scripts/create-zip.ps1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
